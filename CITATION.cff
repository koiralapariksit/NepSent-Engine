    given-names: "Pariksit"
    affiliation: "Kathmandu University"
keywords:
  - "nepali-nlp"
  - "sentiment-analysis"
  - "low-resource-nlp"
  - "devanagari"
  - "inter-annotator-agreement"
  - "bootstrap-confidence-intervals"
  - "reproducibility"

