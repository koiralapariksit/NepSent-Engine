# Nepali Sentiment Analysis Scraper - Environment Configuration
# Copy this file to .env and fill in your credentials

# Twitter API v2 Bearer Token (optional, for social media collection)
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# Daraz E-commerce Settings (optional, for advanced scraping)
# DARAZ_MAX_PRODUCTS=500
# DARAZ_MAX_REVIEWS_PER_PRODUCT=5

# Scraping Rate Limits (in seconds)
# REQUEST_DELAY_BASE=2.0
# REQUEST_DELAY_RANDOM_MAX=3.0

# Output Configuration
# DATA_DIR=./data
# LOGS_DIR=./logs

# Debug Mode (set to True for verbose logging)
# DEBUG_MODE=False

# Sample Mode (set to True to limit collection for testing)
# SAMPLE_MODE=False
